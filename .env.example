# Base URL of the King Domain backend.
# Local default assumes the backend runs on port 4000 (chosen to avoid
# clashing with other local projects on 3000).
VITE_API_BASE=http://localhost:4000

# PostHog project token (client-side, safe to expose — write-only).
VITE_POSTHOG_KEY=phc_your_project_token_here
VITE_POSTHOG_HOST=https://us.i.posthog.com
